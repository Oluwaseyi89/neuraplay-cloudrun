PORT=8000
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=xxxxxxxxxxxx

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=

# Production (Supabase Session pooler). When set, POSTGRES_* below are ignored.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL_REQUIRE=true
DATABASE_TRANSACTION_POOLER=false

# Local PostgreSQL
POSTGRES_DB=neuraplay_db
POSTGRES_USER=neura_play_user
POSTGRES_PASSWORD=xxxxxxxxxxxx
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# Analysis limits (per UTC day) and history lifetime
ANALYSIS_DAILY_LIMIT_PER_USER=3
ANALYSIS_DAILY_LIMIT_PER_IP=5
ANALYSIS_TTL_HOURS=24
# Proxies in front of the app that append X-Forwarded-For (0 locally, 1 on Render)
TRUSTED_PROXY_COUNT=0

GEMINI_API_KEY=xxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash
GENAI_TIMEOUT_SECONDS=30

GOOGLE_CLOUD_CREDENTIALS_BASE64=xxxxxxxxxxxx
GRPC_DNS_RESOLVER=native
